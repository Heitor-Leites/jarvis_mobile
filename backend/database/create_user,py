from getpass import getpass

from database.connection import SessionLocal
from database.models import User
from auth import hash_password


def main():
    print("========== JARVIS ==========")
    print("Criar usuário")
    print()

    username = input("Usuário (ex: seu@gmail.com): ").strip()

    if not username:
        print("Erro: o usuário não pode estar vazio.")
        return

    password = getpass("Senha: ")
    confirm_password = getpass("Confirme a senha: ")

    if not password:
        print("Erro: a senha não pode estar vazia.")
        return

    if password != confirm_password:
        print("Erro: as senhas não coincidem.")
        return

    db = SessionLocal()

    try:
        existing_user = (
            db.query(User)
            .filter(User.username == username)
            .first()
        )

        if existing_user:
            print("Erro: esse usuário já existe.")
            return

        user = User(
            username=username,
            password_hash=hash_password(password),
            active=True,
        )

        db.add(user)
        db.commit()
        db.refresh(user)

        print()
        print("Usuário criado com sucesso!")
        print(f"ID: {user.id}")
        print(f"Usuário: {user.username}")

    except Exception as error:
        db.rollback()
        print()
        print("Erro ao criar usuário:")
        print(error)

    finally:
        db.close()


if __name__ == "__main__":
    main()