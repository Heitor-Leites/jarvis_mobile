/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.30jarvis.com.br; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https://api.30jarvis.com.br; frame-src 'none'; upgrade-insecure-requests

/pages/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/js/*
  Cache-Control: public, max-age=3600

/css/*
  Cache-Control: public, max-age=3600
